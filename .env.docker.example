# ─── Docker Compose env — copy to `.env` then fill in ────────────────────────
#   cp .env.docker.example .env

# Database password (used by both the db container and the backend's DATABASE_URL)
DB_PASSWORD=hospitality

# JWT secrets — CHANGE THESE for any real deployment
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production

# ─── Public URLs ─────────────────────────────────────────────────────────────
# LOCAL:   leave as-is.
# AWS/PROD: set to your server's public address, e.g.
#   NEXT_PUBLIC_API_URL=http://<EC2_PUBLIC_IP>:4000/api/v1
#   FRONTEND_URL=http://<EC2_PUBLIC_IP>:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
FRONTEND_URL=http://localhost:3000

# ─── Optional integrations (blank = feature runs in mock/disabled mode) ──────
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
