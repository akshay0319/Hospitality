# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# ─── Database (MySQL / MariaDB — XAMPP) ───────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE  (XAMPP root has no password)
DATABASE_URL="mysql://root@localhost:3306/hospitality"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── AWS S3 (for file uploads) ────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=hospitality-os-uploads

# ─── Email (SES / SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@hospitalityos.ai

# ─── Twilio (Voice/SMS) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Payments (Razorpay) ──────────────────────────────────────────────────────
# Leave blank to use the built-in mock gateway. Paste rzp_test_* keys for live test-mode checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
